  // Logic Gates
  { kind: "and-gate", label: "AND", category: "Logic Gates", glyph: <><path d="M6 6 H18 A8 8 0 0 1 18 22 H6 Z" /><path d="M2 10 H6 M2 18 H6 M26 14 H32" /></> },
