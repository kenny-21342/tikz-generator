# API key for AI-powered image → TikZ conversion.
# The generate route talks to an OpenAI-compatible /chat/completions endpoint.
# GEMINI_API_KEY  — native Google Gemini key
# GEMINI_AUTH_KEY — explicit proxy auth key (takes precedence when set)
# ANTHROPIC_API_KEY — also works when your base URL is a proxy that bridges both
GEMINI_API_KEY=your_api_key_here
# GEMINI_AUTH_KEY=your_proxy_auth_key_here
# ANTHROPIC_API_KEY=your_api_key_here

# Base URL (optional). Must point at the root that serves /chat/completions.
# Defaults to Google's OpenAI-compatible endpoint:
#   https://generativelanguage.googleapis.com/v1beta/openai
# Point this at your proxy when using a third-party provider.
# GEMINI_BASE_URL=https://your-third-party-api.com/v1

# Model override (optional). Default: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# In-process abuse controls for the paid AI route. These are per server
# instance and reset on cold starts, so also configure a hard provider budget.
# AI_RATE_LIMIT_PER_HOUR=10
# AI_RATE_LIMIT_PER_DAY=40
# AI_GLOBAL_LIMIT_PER_DAY=500
# AI_MAX_TOKENS=4096
# AI_MONTHLY_LIMIT=500

# Required in production for cross-instance rate limits and the monthly cap.
# Vercel's Upstash integration may provide the KV_* names instead.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your_redis_rest_token

# LaTeX preview requires a TeX distribution (pdflatex) and a PDF→PNG converter
# (pdftoppm, macOS sips, or ImageMagick) available on the server PATH.
